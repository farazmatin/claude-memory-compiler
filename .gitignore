# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Tier 1: source audio and transcripts.
# Immutable source material, but large and personal - never committed.
# These are the inputs the whole system compiles from; back them up separately.
inbox/
audio/
transcripts/

# Retained voice clips for speaker labelling. Small (~30 KB per speaker) but they
# are recorded voice, and biometric material never belongs in version control.
snippets/

# Tier 2: compiled minutes.
# The RAG corpus. Ignored by default because meeting content is sensitive;
# remove this line if you want minutes version-controlled.
minutes/

# Manifest database (rebuildable from audio/ + transcripts/, but slow - back it up)
db/

# Test artifacts. A Windows shlex bug once wrote alert output to mangled
# filenames in the repo root; the bug is fixed, this is belt and braces.
*pytest-of-*
alert.txt

# Local state and logs
*.log
speaker-overrides.yaml

# Secrets
.env
drive-client.json
drive-token.json

# LightRAG server working data
rag_storage/

# Claude Code local settings
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

.obsidian/

# Local backups made before migrations. Contain private minutes and transcripts.
pre-postgres-backup/

# Timestamped .env backups carry the same secrets as .env itself.
.env.bak-*
