# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Tier 1: source audio and transcripts.
# Immutable source material, but large and personal - never committed.
# These are the inputs the whole system compiles from; back them up separately.
inbox/
audio/
transcripts/

# Tier 2: compiled minutes.
# The RAG corpus. Ignored by default because meeting content is sensitive;
# remove this line if you want minutes version-controlled.
minutes/

# Manifest database (rebuildable from audio/ + transcripts/, but slow - back it up)
db/

# Local state and logs
*.log
speaker-overrides.yaml

# Secrets
.env

# LightRAG server working data
rag_storage/

# Claude Code local settings
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db

.obsidian/
