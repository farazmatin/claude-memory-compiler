# Copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────

# Protects the LightRAG graph service. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# docker compose refuses to start without it, on purpose: this graph holds every
# decision and customer conversation in the corpus.
MMC_LIGHTRAG_API_KEY=

# Postgres password. Generate one the same way.
# LightRAG stores its KV, vector, doc-status and graph data here rather than in
# the file-based defaults, which do not hold thousands of documents.
POSTGRES_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────

# Your own name. Used to disambiguate two-speaker recordings.
# MMC_OWNER_NAME=

# LLM provider chain. Codex and Claude are always normalized to the first two
# positions; Antigravity is the normal final fallback.
# MMC_LLM_PROVIDERS=codex,claude,antigravity

# Pin the Gemini model. Left unset, the Gemini CLI picks its own default.
# MMC_GEMINI_MODEL=

# Timezone. Meeting dates depend on it; a wrong value mislabels the corpus.
# MMC_TIMEZONE=America/Toronto

# Failure alerting. Invoked when an on-demand run fails, summary on stdin,
# {subject} substituted.
# MMC_ALERT_COMMAND=curl -s -d @- https://ntfy.sh/my-topic
# MMC_ALERT_COMMAND=mail -s "{subject}" me@example.com

# Speaker count bounds passed to the remote diarization provider.
# MMC_MIN_SPEAKERS=2
# MMC_MAX_SPEAKERS=6
# MMC_IMPLAUSIBLE_SPEAKERS=8

# Remote transcription (the only supported ASR path):
# Add your Replicate API token from https://replicate.com/account/api-tokens:
# REPLICATE_API_TOKEN=r8_...
# MMC_REPLICATE_MODEL=victor-upmeet/whisperx

# Upload reliability. Large bodies get reset mid-transfer on a flaky path, and a
# meeting whose upload never lands is parked with no minutes. Send less, retry
# longer, and let a later run pick up what still failed.
# Encoding of the uploaded copy. 32k Opus is ~2x smaller than 64k MP3 with the
# same transcript and diarization; below 32k the quietest speakers start merging.
# MMC_UPLOAD_CODEC=libopus
# MMC_UPLOAD_BITRATE=32k
# Upload attempts and the exponential backoff between them, in seconds.
# MMC_REPLICATE_UPLOAD_ATTEMPTS=8
# MMC_REPLICATE_UPLOAD_BACKOFF=5.0
# MMC_REPLICATE_UPLOAD_BACKOFF_MAX=60.0
# Times a later `pipeline run` may requeue a meeting that failed on a network
# fault before leaving it parked for `pipeline status` to report.
# MMC_AUTO_REQUEUE_LIMIT=3

# Remote speaker embedding, which is what makes a name given once carry into
# later meetings. A second paid Replicate call per new meeting, so it is off
# until you set the model: unset, `pipeline voice` no-ops and everything else
# behaves exactly as it does today.
# MMC_REMOTE_VOICE_MODEL=farazmatin/speaker-embed
# Pin the version once an encoder has been benchmarked. Unset, the version in
# use is resolved from the model and still namespaces the vectors it produced.
# MMC_REMOTE_VOICE_VERSION=
# Which encoder the model serves.
# MMC_REMOTE_VOICE_ENCODER=wespeaker-resnet34-lm
# Seconds of one speaker's audio sent per embedding. A bound on cost, not an
# accuracy setting - MMC_VOICE_MIN_SPEECH_SEC is already the floor for that.
# MMC_VOICE_MAX_EMBED_SEC=90


# Point Tier 1 storage at a bigger disk. Audio runs ~2-4 MB/hr after
# normalization, ~18 MB/hr if you archive the originals untouched.
# MMC_INBOX=/mnt/recordings/inbox
# MMC_AUDIO=/mnt/recordings/audio
# MMC_TRANSCRIPTS=/mnt/recordings/transcripts

# MMC_LIGHTRAG_URL=http://localhost:9621

# Postgres identity, if you want something other than the defaults.
# POSTGRES_USER=lightrag
# POSTGRES_DATABASE=rag

# Minutes prompt budget. Over this, the compiler condenses a long meeting via
# per-window extraction instead of overflowing the context window.
# MMC_MINUTES_TOKEN_BUDGET=60000
# MMC_MINUTES_MAP_WINDOW=20000

# Antigravity (`agy`) is the CLI that actually holds a live Google session.
# Its model namespace is NOT the standalone gemini CLI's: gemini-3.7-flash-*
# exists here and is unknown there. Suffix is reasoning effort (high|medium|low).
# MMC_ANTIGRAVITY_BIN=agy
# MMC_ANTIGRAVITY_MODEL=gemini-3.7-flash-medium
# MMC_LLM_PROVIDERS=codex,claude,antigravity

# Dashboard access control. Empty is fine while MMC_DASHBOARD_HOST is 127.0.0.1 -
# the bind address is the boundary for a single-user setup. Binding anywhere else
# without this set makes the dashboard REFUSE TO START, because it serves meeting
# minutes and DELETE /api/meetings/{id}. Required before any phone/Tailscale access.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# MMC_DASHBOARD_TOKEN=
